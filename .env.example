# App Settings
APP_NAME=ai-assistant-dkreasi
APP_ENV=local
DEBUG=true
PORT=8001
HOST=0.0.0.0

# Security & CORS
ALLOWED_ORIGINS=http://localhost:8000,http://127.0.0.1:8000,http://localhost:8001,http://127.0.0.1:8001,http://localhost:8002,http://127.0.0.1:8002,http://localhost:8003,http://127.0.0.1:8003,http://localhost:3000,https://webia.id,https://d-kreasi.com,https://dkarsa.id

# LLM Gateway (9router)
LLM_BASE_URL=http://localhost:20128/v1
LLM_API_KEY=
LLM_MODEL=d-kreasi
LLM_TEMPERATURE=0.2
LLM_MAX_TOKENS=2048
LLM_TIMEOUT=60

# Database & Storage
DATABASE_URL=sqlite+aiosqlite:///data/app.db
FAISS_BASE_PATH=data/faiss_index
EMBEDDING_MODEL=intfloat/multilingual-e5-small

# Customer Support WhatsApp Handoff
AI_CS_WHATSAPP=6289603056349
AI_CS_DEFAULT_MESSAGE="Halo CS PakDe Group, saya ingin berkonsultasi mengenai layanan D-KREASI."
